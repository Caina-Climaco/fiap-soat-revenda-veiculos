# Modelo do .env do docker compose (desenvolvimento local). Copie para .env e TROQUE
# todos os valores "troque-..." — o .env é ignorado pelo Git (ADR-011). No cluster kind
# estes valores são gerados pelo Terraform e entregues como Secrets; nada disto é usado lá.

# ---------------------------------------------------------------- banco da API
DB_NAME=revenda
DB_USER=revenda
DB_PASSWORD=troque-senha-do-banco-da-api

# ---------------------------------------------------------------- API
# Segredo compartilhado com o gateway (header X-Webhook-Secret): 16+ caracteres.
WEBHOOK_SECRET=troque-por-um-segredo-longo-do-webhook
RESERVA_TTL_MINUTOS=30
LOG_LEVEL=INFO

# O Keycloak tem o próprio .env, no repositório fiap-soat-revenda-identidade.

# ---------------------------------------------------------------- testes (fora do compose)
# Integração contra o PostgreSQL do compose (use a mesma senha de DB_PASSWORD):
# TEST_DATABASE_URL=postgresql+psycopg://revenda:<DB_PASSWORD>@localhost:5432/revenda_test
